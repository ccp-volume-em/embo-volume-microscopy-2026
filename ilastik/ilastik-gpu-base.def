Bootstrap: docker
From: ubuntu:24.04

%arguments
    ILASTIK_VERSION=1.4.2

%post
    apt-get update -y
    apt-get install -y --no-install-recommends \
        wget \
        bzip2 \
        ca-certificates \
        libgl1 \
        libglu1-mesa \
        libxcb-cursor0 \
        libxkbcommon-x11-0 \
        libxrender1 \
        libxi6 \
        libfontconfig1 \
        libdbus-1-3

    # ilastik GPU-enabled standalone (bundles CUDA + PyTorch)
    wget https://files.ilastik.org/ilastik-{{ ILASTIK_VERSION }}-gpu-Linux.tar.bz2
    tar -xjf ilastik-{{ ILASTIK_VERSION }}-gpu-Linux.tar.bz2 -C /opt
    rm ilastik-{{ ILASTIK_VERSION }}-gpu-Linux.tar.bz2
    mv /opt/ilastik-* /opt/ilastik

    # run_ilastik.sh clears LD_LIBRARY_PATH, including driver paths injected by apptainer - patch this
    sed -i 's/^export LD_LIBRARY_PATH=""$/export LD_LIBRARY_PATH="${LD_LIBRARY_PATH_NV:-}"/' /opt/ilastik/run_ilastik.sh

    apt-get purge -y wget
    rm -rf /var/lib/apt/lists/*

%environment
    export NUMBA_CACHE_DIR=/tmp/numba_cache
    export BIOIMAGEIO_CACHE_PATH="/tmp/$(whoami)/pybio_cache"

%runscript
    export LD_LIBRARY_PATH_NV="$LD_LIBRARY_PATH"
    exec /opt/ilastik/run_ilastik.sh "$@"
