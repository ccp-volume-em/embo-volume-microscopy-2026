Bootstrap: docker
From: ubuntu:24.04

%arguments
    ILASTIK_VERSION=1.4.2

%post
    apt-get update -y
    apt-get install -y --no-install-recommends \
        wget \
        bzip2 \
        ca-certificates \
        libgl1 \
        libgl1-mesa-dri \
        libglu1-mesa \
        libxcb-cursor0 \
        libxkbcommon-x11-0 \
        libxrender1 \
        libxi6 \
        libfontconfig1 \
        libdbus-1-3

    # CPU-only standalone
    wget https://files.ilastik.org/ilastik-{{ ILASTIK_VERSION }}-Linux.tar.bz2
    tar -xjf ilastik-{{ ILASTIK_VERSION }}-Linux.tar.bz2 -C /opt
    rm ilastik-{{ ILASTIK_VERSION }}-Linux.tar.bz2
    mv /opt/ilastik-* /opt/ilastik

    apt-get purge -y wget
    rm -rf /var/lib/apt/lists/*

%environment
    export NUMBA_CACHE_DIR=/tmp/numba_cache
    export BIOIMAGEIO_CACHE_PATH="/tmp/$(whoami)/pybio_cache"
	# Ensure software rendering
    export LIBGL_ALWAYS_SOFTWARE=1

%runscript
    exec /opt/ilastik/run_ilastik.sh "$@"
